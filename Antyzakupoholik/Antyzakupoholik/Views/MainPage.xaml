<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Antyzakupoholik.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Antyzakupoholik.ViewModels">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="Antyzakupoholik" />

            <Frame Padding="15">

                <VerticalStackLayout>

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Limit wydatków" />

                    <Label
                        FontSize="24"
                        Text="{Binding SpendingLimit}" />

                </VerticalStackLayout>

            </Frame>
            <Button
    Text="Ustaw limit"
    Command="{Binding SetLimitCommand}" />
            <Label
    Text="PRZEKROCZONO LIMIT!"
    TextColor="Red"
    IsVisible="{Binding IsLimitExceeded}" />
            <Frame Padding="15">

                <VerticalStackLayout>

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Wydano" />

                    <Label
                        FontSize="24"
                        Text="{Binding CurrentSpent}" />

                </VerticalStackLayout>

            </Frame>
            <Button
    Text="Dodaj wydatek"
    Command="{Binding AddExpenseCommand}" />
            
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Wydatki" />

            <CollectionView
                ItemsSource="{Binding Expenses}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame Margin="0,5">
                            <Frame.Triggers>

                                <DataTrigger
            TargetType="Frame"
            Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                              Path=BindingContext.IsLimitExceeded}"
            Value="True">

                                    <Setter
                Property="BackgroundColor"
                Value="LightCoral"/>

                                </DataTrigger>

                            </Frame.Triggers>
                            <Frame.GestureRecognizers>

                                <TapGestureRecognizer
                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}},
                                  Path=OpenExpenseCommand}"
                CommandParameter="{Binding .}" />

                            </Frame.GestureRecognizers>

                            <VerticalStackLayout>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding Name}" />

                                <Label
                                    Text="{Binding Amount}" />

                                <Label
                                    FontSize="12"
                                    Text="{Binding CreatedAt}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <Button
    Text="Archiwa"
    Command="{Binding OpenArchivesCommand}" />
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>