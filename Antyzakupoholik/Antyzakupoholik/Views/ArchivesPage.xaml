<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Antyzakupoholik.Views.ArchivesPage"
             Title="ArchivesPage">
    <VerticalStackLayout>
        <CollectionView
    ItemsSource="{Binding Archives}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="5">
                        <Frame.GestureRecognizers>

                            <TapGestureRecognizer
        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                          Path=BindingContext.OpenArchiveCommand}"
        CommandParameter="{Binding .}" />

                        </Frame.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label
                                TextColor="White"
                                Text="{Binding ArchiveDate}" />

                            <Label
                                TextColor="White"
                        Text="{Binding TotalSpent}" />

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>
    </VerticalStackLayout>
</ContentPage>