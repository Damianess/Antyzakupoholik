<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Antyzakupoholik.Views.AddExpensePage">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Entry
            Placeholder="Nazwa"
            Text="{Binding Name}" />

        <Entry
            Placeholder="Opis"
            Text="{Binding Description}" />

        <Entry
            Placeholder="Kwota"
            Keyboard="Numeric"
            Text="{Binding Amount}" />

        <Button
            Command="{Binding SaveCommand}"
            Text="Zapisz" />

    </VerticalStackLayout>

</ContentPage>