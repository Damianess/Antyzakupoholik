<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Antyzakupoholik.Views.ExpenseDetailsPage">

    <VerticalStackLayout
        Padding="20">

        <Label
            FontSize="24"
            Text="{Binding Name}" />

        <Label
            Text="{Binding Description}" />

        <Label
            Text="{Binding Amount}" />

        <Button
            Text="Usuń"
            Command="{Binding DeleteCommand}" />

    </VerticalStackLayout>

</ContentPage>